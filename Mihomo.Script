// ===================== 主函数 =====================
function main(config) {
  // 覆盖代理组配置
  config["proxy-groups"] = [
    {
      ...groupBaseOption,
      "name": "🌐节点选择",
      "type": "select",
      "proxies": ["♻️延迟选优", "🔯故障转移", "🔮负载均衡·散列", "🔮负载均衡·轮询", "☑️手动切换", "DIRECT"],
      "include-all": false
    },
    {
      ...groupBaseOption,
      "name": "☑️手动切换",
      "type": "select",
      "proxies": ["REJECT", "DIRECT"],
      "include-all": true
    },
    {
      ...groupBaseOption,
      "name": "♻️延迟选优",
      "type": "url-test",
      "tolerance": 100,
      "include-all": true
    },
    {
      ...groupBaseOption,
      "name": "🔯故障转移",
      "type": "fallback",
      "include-all": true
    },
    {
      ...groupBaseOption,
      "name": "🔮负载均衡·散列",
      "type": "load-balance",
      "strategy": "consistent-hashing",
      "include-all": true
    },
    {
      ...groupBaseOption,
      "name": "🔮负载均衡·轮询",
      "type": "load-balance",
      "strategy": "round-robin",
      "include-all": true
    },
    {
      ...groupBaseOption,
      "name": "🎯全球直连",
      "type": "select",
      "proxies": ["DIRECT", "🌐节点选择"]
    },
    {
      ...groupBaseOption,
      "name": "🛑全球拦截",
      "type": "select",
      "proxies": ["REJECT", "DIRECT"]
    },
    {
      ...groupBaseOption,
      "name": "🐟漏网之鱼",
      "type": "select",
      "proxies": ["🌐节点选择", "♻️延迟选优", "🔯故障转移", "🎯全球直连"],
      "include-all": true
    }
  ];

 config["rule-providers"] = ruleProviders;
  config["rules"] = rules;
  config["dns"] = dnsConfig;
  config["sniffer"] = { "enable": true, "sniff": { "TLS": { "ports": [443, 8443], "override-destination": true }, "HTTP": { "ports": [80, "8080-8880"], "override-destination": true }, "QUIC": { "ports": [443] } } };
  config["log-level"] = "error";

  return config;
}
